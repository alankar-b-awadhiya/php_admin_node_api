# ==============================================================================
# ABA Master Admin Panel — public/.htaccess
# This directory is the web root (Apache DocumentRoot should point here).
# app/ (config + includes) lives OUTSIDE this folder and is never web-accessible.
# ==============================================================================

# ------------------------------------------------------------------
# 1. Force HTTPS (skip on local dev where HTTPS isn't set up)
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# 2. Never serve directory listings
# ------------------------------------------------------------------
Options -Indexes

# Follow symlinks only where needed, disable server-side includes / CGI exec here
Options -Includes -ExecCGI

# ------------------------------------------------------------------
# 3. Block access to dotfiles (.env, .git, .htaccess itself, etc.)
# ------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Block common backup / editor / VCS artifacts from ever being served
<FilesMatch "(\.bak|\.old|\.orig|\.sql|\.log|~)$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------------
# 4. Security headers
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Only set HSTS once you're fully on HTTPS in production
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Remove the PHP version / server banner from response headers
  Header unset X-Powered-By
</IfModule>
ServerSignature Off

# ------------------------------------------------------------------
# 5. PHP execution inside assets/ is blocked via public/assets/.htaccess
#    (a <Directory> block here would be invalid in .htaccess context)
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# 6. Caching + compression for static assets
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# ------------------------------------------------------------------
# 7. Friendly error pages (create these files if you want custom ones)
# ------------------------------------------------------------------
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php

# ------------------------------------------------------------------
# 8. Default character set
# ------------------------------------------------------------------
AddDefaultCharset UTF-8
